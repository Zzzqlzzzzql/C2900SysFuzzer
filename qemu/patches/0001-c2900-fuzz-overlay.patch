diff --git a/include/fuzz/coverage.h b/include/fuzz/coverage.h
new file mode 100644
index 0000000..8c8cb1d
--- /dev/null
+++ b/include/fuzz/coverage.h
@@ -0,0 +1,176 @@
+#ifndef FUZZ_COVERAGE_H
+#define FUZZ_COVERAGE_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <glib.h>
+
+/*
+ * 边覆盖 bitmap 大小（与 AFLNet 的 MAP_SIZE 保持一致）
+ */
+#define EDGE_MAP_SIZE 65536
+/* 边覆盖共享内存 key（仅供 AFLNet 读取） */
+#define FUZZ_SHM_EDGE_KEY 0x2000
+#define FUZZ_SHM_EDGE_SIZE sizeof(uint8_t[EDGE_MAP_SIZE])
+/* 退出状态共享内存 key（waitpid 格式 status，仅供 AFLNet 读取） */
+#define FUZZ_SHM_EXIT_KEY 0x2001
+#define FUZZ_SHM_EXIT_SIZE sizeof(uint32_t)
+/* 退出状态哨兵值：快速恢复后程序未退出时为该值，fuzzer 读到即视为本轮超时 */
+#define FUZZ_EXIT_TIMEOUT 0xDEADBEEF
+
+/* 入口指纹指令条数 */
+#define ENTRY_INSTR_COUNT 8
+
+/* 自动保存快照通知管道 */
+#define FUZZ_AUTO_PIPE "/tmp/qemu_fuzz_auto"
+
+/* 日志域 */
+#ifndef LOG_DOMAIN
+#define LOG_DOMAIN "coverage"
+#endif
+
+/*
+ * 目标类型：
+ *   - LINUX_USER：原 QemuSysFuzzer 的 Linux 用户态目标（ASID/用户态/ASLR 模型）
+ *   - IOS：C2900 等整机固件目标（单地址空间、全程内核态，无 ASID/用户态语义）
+ */
+typedef enum {
+    FUZZ_TARGET_LINUX_USER = 0,
+    FUZZ_TARGET_IOS = 1,
+} FuzzTargetType;
+
+/*
+ * 覆盖率地址 canonical 方式。IOS 固件中同一段代码会以 KSEG0（0x81...）、
+ * 运行时 TLB 映射（0x21/0x25...）等多个虚拟地址出现，必须归一化成同一个
+ * key，否则同一基本块会产生多套边。
+ */
+typedef enum {
+    FUZZ_ADDR_CANON_VIRT = 0,   /* 原始虚拟地址（不推荐） */
+    FUZZ_ADDR_CANON_KSEG0 = 1,  /* 归一到 KSEG0 0x81... */
+    FUZZ_ADDR_CANON_PHYS = 2,   /* 物理地址（推荐，同一代码唯一） */
+} FuzzAddrMode;
+
+/*
+ * 崩溃判定模式：
+ *   OFF：不检测（默认）
+ *   LOG：只把命中的哨兵/异常写日志，不改变 shm 0x2001（用于标定）
+ *   ON ：把崩溃编码成 waitpid 格式写入 shm 0x2001，AFLNet 直接判 crash
+ */
+typedef enum {
+    FUZZ_CRASH_OFF = 0,
+    FUZZ_CRASH_LOG = 1,
+    FUZZ_CRASH_ON = 2,
+} FuzzCrashMode;
+
+#define MAX_PANIC_ADDRS 32
+
+/* TB 映射表条目（canon_addr 为 hash key） */
+typedef struct {
+    uint64_t canon_addr;  /* hash key：归一化后的地址 */
+    uint64_t virt_addr;   /* TB 执行时的虚拟 PC */
+    uint64_t phys_addr;   /* TB 首个物理页地址（含页内偏移）；-1 表示不可用 */
+    uint64_t asid;        /* 所属进程 ASID（IOS 模式恒为 0） */
+    uint64_t exec_count;
+    uint64_t insn_count;
+} CoverageEntry;
+
+/* 执行 trace 链表节点（数组顺序即执行顺序；addr 为 canonical 地址） */
+typedef struct FuzzTraceEntry {
+    uint64_t virt_addr;   /* canonical 地址 */
+    uint32_t cur_loc;
+    uint32_t exec_count;
+    struct FuzzTraceEntry *next;
+} FuzzTraceEntry;
+
+/* 覆盖率配置（由 -fuzz 参数指定的 JSON 文件解析而来） */
+typedef struct {
+    int mode;                   /* 0: ELF 指纹 + .text 物理范围过滤
+                                 * 1: ELF 指纹 + 全范围收集
+                                 * 2: 手动输入指纹字段
+                                 * 3: IOS 手动配置（不使用 Linux 目标识别） */
+    FuzzTargetType target_type;
+    bool debug;
+    bool auto_snapshot;
+    bool cov_block;
+    bool cov_edge;
+    bool cov_trace;
+    bool no_asid;               /* IOS 模式为 true：不按 ASID/用户态过滤 */
+    /* IOS：每轮从空 bitmap 开始（不恢复启动 baseline）。
+     * 开机/CLI 会覆盖几乎整个 .text，若把 baseline 写回 64K bitmap，
+     * map density 会接近 100%，fuzzer 没有空间记录新边。 */
+    bool exclude_baseline;
+    bool exclude_baseline_set;
+    char *elf_path;
+    uint64_t entry_addr;
+    uint64_t text_start;
+    uint64_t text_size;
+    uint32_t inst_ratio;
+
+    /* IOS 模式字段 */
+    uint64_t firmware_entry;    /* 固件加载入口，如 0x81000000 */
+    uint64_t service_entry;     /* 服务入口（0 表示未知） */
+    uint64_t snapshot_trigger;  /* 命中该地址时自动快照（0 表示不自动） */
+    uint64_t coverage_start;    /* canonical 过滤范围（含） */
+    uint64_t coverage_end;      /* canonical 过滤范围（不含） */
+    uint64_t runtime_delta;     /* 0x21 -> KSEG0 的归一化差值 */
+    FuzzAddrMode addr_mode;     /* canonical 方式 */
+    /* 快照限定设备（可选）。设置后 save_snapshot 只对该块设备做快照，
+     * 避免 raw 盘不支持内部快照，也避免每轮回滚整个磁盘。 */
+    char *snapshot_device;
+    /* 快照名称（可选）。默认 fuzz_snapshot；按协议区分时便于日志与维护。 */
+    char *snapshot_name;
+
+    /* 崩溃判定（IOS） */
+    FuzzCrashMode crash_mode;
+    uint64_t panic_addrs[MAX_PANIC_ADDRS]; /* L0 哨兵地址（virt/phys/低32位均可） */
+    size_t panic_addr_count;
+    uint32_t crash_status;       /* waitpid 低 7 位；默认 11=SIGSEGV */
+    bool crash_on_reset;         /* guest reset 是否判崩溃（L1） */
+    uint32_t crash_exception_mask; /* L4：按 MIPS ExcCode 置位 */
+
+    uint32_t instrs[ENTRY_INSTR_COUNT];
+    size_t instr_count;
+    uint32_t wait_snapshot_restore;
+    uint32_t wait_program_done;
+} FuzzConfig;
+
+/* 初始化覆盖率模块（解析配置、ELF，初始化数据结构） */
+void fuzz_coverage_init(const char *config_path);
+/* 记录一个已执行 TB 的覆盖率（由主循环 TB 执行出口调用） */
+void fuzz_coverage_record_tb(uint64_t virt_addr, uint64_t phys_addr, uint32_t insn_count, uint64_t asid, bool user_mode);
+/* 记录目标进程退出（Linux 模式，IOS 模式下忽略） */
+void fuzz_coverage_record_exit(uint64_t asid, uint32_t exit_code);
+/* 记录目标进程被信号终止（Linux 模式，IOS 模式下忽略） */
+void fuzz_coverage_record_signal(uint64_t asid, uint32_t sig, uint64_t pc);
+/* 记录目标进程疑似故障（Linux 模式，IOS 模式下忽略） */
+void fuzz_coverage_record_fault(uint64_t asid, uint64_t pc);
+
+/* IOS 崩溃判定：L0 哨兵命中 / L4 异常 / L1 guest reset。
+ * crash_mode=LOG 只记录；crash_mode=ON 写 shm 0x2001（waitpid 格式）。 */
+void fuzz_coverage_record_crash(const char *reason, uint64_t pc);
+void fuzz_coverage_record_exception(uint32_t exc_code, uint64_t pc, uint64_t badvaddr);
+void fuzz_coverage_record_guest_reset(void);
+/* 异常钩子快速开关（无异常掩码时不进入锁） */
+bool fuzz_coverage_crash_exception_enabled(void);
+/* 绑定实时共享内存 */
+void fuzz_coverage_set_shm(uint8_t *edge_map, uint32_t *exit_status);
+/* 是否开启自动保存快照 */
+bool fuzz_coverage_auto_snapshot(void);
+/* 是否为 IOS 目标 */
+bool fuzz_coverage_is_ios(void);
+/* 快照限定设备名（NULL 表示不限定，使用所有块设备） */
+const char *fuzz_coverage_snapshot_device(void);
+/* 配置的快照名（NULL 表示使用默认 fuzz_snapshot） */
+const char *fuzz_coverage_snapshot_name(void);
+/* 将当前覆盖率状态深拷贝为备份（save_snapshot 成功后调用） */
+void fuzz_coverage_backup(void);
+/* 重置本轮测试的覆盖率数据（恢复为保存快照时的状态，无备份时全清零） */
+void fuzz_coverage_reset(void);
+/* 输出覆盖率信息 */
+void fuzz_coverage_dump(uint64_t fuzz_count);
+/* 各轮等待配置（毫秒） */
+uint32_t fuzz_coverage_wait_snapshot_restore(void);
+uint32_t fuzz_coverage_wait_program_done(void);
+
+#endif
