# HTTPS protocol campaign
# 由 scripts/protocol.sh 读取；路径相对于项目根目录 / $C2900_PKG。
PROTO_NAME=https
DISPLAY_NAME="HTTPS"
CONFIG_SCRIPT_REL=runtime/protocols/https/configure.py
SNAPSHOT_NAME=snap_https
AFLNET_PROTOCOL=TLS
NET_TRANSPORT=tcp
NET_PORT=443
GUEST_IP=172.16.100.2
KERNEL_REL=firmware/c2900-universalk9-mz.SPA.150-1.M9.bin
BOOT_TIMEOUT=1200
CONFIG_TIMEOUT=1800
NET_MODE=${NET_MODE:-socket}
NOTES="C2900 仅支持 SSLv3+RC4；AFLNet -P TLS 需先验证旧握手，种子需包含真实 SSLv3 握手。"
C2900_CONFIG_PROMPT_TIMEOUT=300
C2900_CONFIG_TEXT_TIMEOUT=600
C2900_CONFIG_RSA_TIMEOUT=900
