# IPsec protocol campaign
# 由 scripts/protocol.sh 读取；路径相对于项目根目录 / $C2900_PKG。
PROTO_NAME=ipsec
DISPLAY_NAME="IPsec"
CONFIG_SCRIPT_REL=runtime/protocols/ipsec/configure.py
SNAPSHOT_NAME=snap_ipsec
AFLNET_PROTOCOL=CUSTOM
NET_TRANSPORT=udp
NET_PORT=500
GUEST_IP=172.16.100.2
KERNEL_REL=firmware/c2900-universalk9-mz.SPA.150-1.M9.bin
BOOT_TIMEOUT=1200
CONFIG_TIMEOUT=1800
NET_MODE=${NET_MODE:-socket}
NOTES="AFLNet 无 IKE/ESP 的 -P；需自定义 harness。securityk9 license 与 config_ipsec_license.py 需在本次启动前完成并重启。"
C2900_CONFIG_PROMPT_TIMEOUT=300
C2900_CONFIG_TEXT_TIMEOUT=600
C2900_CONFIG_RSA_TIMEOUT=900
