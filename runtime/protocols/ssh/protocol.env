# SSH protocol campaign
# 由 scripts/protocol.sh 读取；路径相对于项目根目录 / $C2900_PKG。
PROTO_NAME=ssh
DISPLAY_NAME="SSH"
CONFIG_SCRIPT_REL=runtime/protocols/ssh/configure.py
SNAPSHOT_NAME=snap_ssh
AFLNET_PROTOCOL=SSH
NET_TRANSPORT=tcp
NET_PORT=22
GUEST_IP=172.16.100.2
KERNEL_REL=firmware/c2900-universalk9-mz.SPA.150-1.M9.bin
BOOT_TIMEOUT=1200
CONFIG_TIMEOUT=1800
NET_MODE=${NET_MODE:-socket}
NOTES="config_ssh.py 会把 VTY 从 Telnet 切到 SSH；C2900 使用旧 KEX/cipher。"
C2900_CONFIG_PROMPT_TIMEOUT=300
C2900_CONFIG_TEXT_TIMEOUT=600
C2900_CONFIG_RSA_TIMEOUT=900
