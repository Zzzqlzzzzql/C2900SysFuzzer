# Telnet protocol campaign
# 由 scripts/protocol.sh 读取；路径相对于项目根目录 / $C2900_PKG。
PROTO_NAME=telnet
DISPLAY_NAME="Telnet"
CONFIG_SCRIPT_REL=runtime/protocols/telnet/configure.py
SNAPSHOT_NAME=snap_telnet
AFLNET_PROTOCOL=NONE
NET_TRANSPORT=tcp
NET_PORT=23
GUEST_IP=172.16.100.2
KERNEL_REL=firmware/c2900-universalk9-mz.SPA.150-1.M9.bin
BOOT_TIMEOUT=1200
CONFIG_TIMEOUT=1800
NET_MODE=${NET_MODE:-socket}
NOTES="AFLNet 的 -P 列表不含 Telnet；仅保存快照/覆盖率，需要自定义提取器。"
C2900_CONFIG_PROMPT_TIMEOUT=300
C2900_CONFIG_TEXT_TIMEOUT=600
C2900_CONFIG_RSA_TIMEOUT=900
