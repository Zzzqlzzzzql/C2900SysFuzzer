+/* Connect to the external QEMU system-mode forkserver (-Z mode). The
+   pipes and shared memory are created by QEMU; we only open/attach them,
+   then ask QEMU to snapshot the current (stable) VM state. */
+
+EXP_ST void init_forkserver_qemu(void) {
+
+  ACTF("Connecting to QEMU system forkserver...");
+
+  /* Edge bitmap SHM - already attached by setup_shm(). */
+
+  /* Exit status SHM (waitpid-format, published by QEMU at end of test). */
+
+  {
+    s32 s_id = shmget(QEMU_FUZZ_EXIT_SHM_KEY, sizeof(u32), 0666);
+
+    if (s_id < 0)
+      PFATAL("shmget(0x%x) failed - is QEMU running with -fuzz?", QEMU_FUZZ_EXIT_SHM_KEY);
+
+    qemu_exit_status_ptr = shmat(s_id, NULL, 0);
+
+    if (qemu_exit_status_ptr == (u32*)-1) PFATAL("shmat() failed for exit status");
+
+  }
+
+  fsrv_ctl_fd = open(QEMU_FUZZ_CTL_PIPE, O_WRONLY);
+
+  if (fsrv_ctl_fd < 0)
+    PFATAL("Unable to open %s - is QEMU running with -fuzz?", QEMU_FUZZ_CTL_PIPE);
+
+  fsrv_st_fd = open(QEMU_FUZZ_ST_PIPE, O_RDONLY);
+
+  if (fsrv_st_fd < 0)
+    PFATAL("Unable to open %s", QEMU_FUZZ_ST_PIPE);
+
+  /* No real forkserver process: use a sentinel no kill() path touches. */
+
+  forksrv_pid = -1;
+
+  /* Ask QEMU to save the snapshot of the current stable VM state. */
+
+  {
+
+    u8 cmd = QEMU_CMD_SAVE_SNAPSHOT;
+    s32 status;
+
+    if (write(fsrv_ctl_fd, &cmd, 1) != 1)
+      PFATAL("Unable to request snapshot save from QEMU");
+
+    if (read(fsrv_st_fd, &status, 4) != 4)
+      PFATAL("No reply from QEMU forkserver on snapshot save");
+
+    if (status != 1)
+      FATAL("QEMU forkserver failed to save snapshot (status %d)", status);
+
+  }
+
+  OKF("QEMU system forkserver connected, snapshot saved.");
+
+}
